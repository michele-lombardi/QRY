{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QRY",
  "version": "0.1.2-2",
  "identifier": "app.typepulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "onboarding",
        "title": "Set up QRY",
        "url": "onboarding.html",
        "visible": false,
        "skipTaskbar": false,
        "width": 620,
        "height": 650,
        "minWidth": 620,
        "minHeight": 650,
        "maxWidth": 620,
        "maxHeight": 650,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "center": true
      },
      {
        "label": "main",
        "title": "QRY Settings",
        "visible": false,
        "skipTaskbar": true,
        "width": 900,
        "height": 680,
        "minWidth": 760,
        "minHeight": 580,
        "center": true
      },
      {
        "label": "dashboard",
        "title": "QRY Today",
        "url": "dashboard.html",
        "visible": false,
        "skipTaskbar": true,
        "width": 360,
        "height": 470,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "statistics",
        "title": "QRY Statistics",
        "url": "statistics.html",
        "visible": false,
        "skipTaskbar": true,
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
